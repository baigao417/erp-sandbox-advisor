# Root allowlist: only public product files are eligible for staging.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/src/
!/tests/
!/docs/
!/prompts/
!/data/

# The only data file approved for publication is the synthetic example.
/data/*
!/data/examples/
/data/examples/*
!/data/examples/synthetic_scenario.json

# Runtime, workstation, credentials, and internal collaboration files.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
.venv/
venv/
node_modules/
dist/
build/
*.egg-info/
.env
.env.*
*cookie*
*token*
*secret*
*credential*
*provider*
*.pem
*.key
.git/
.agents/
.codex/
.trellis/
.ace-tool/
.idea/
.vscode/
AGENTS.md
CLAUDE.md
handoff.md
PROJECT_STATUS.md
lessons.md
docx/
raw/
internal/
agent-runs/
runs/
outputs/
logs/
*.log
*.db
*.sqlite*
*.pkl
*.pdf
*.docx
*.pptx
*.xlsx
*.xls
*.zip
*.exe
*.mp4
*.mp3
*.wav
*.m4a
*.png
*.jpg
*.jpeg
*.webp

# Docs, prompts, source and tests also use bounded file allowlists.
/docs/*
!/docs/input-contract.md
!/docs/rule-summary.md
/prompts/*
!/prompts/decision-review.md
/src/*
!/src/erp_sandbox_advisor/
/src/erp_sandbox_advisor/*
!/src/erp_sandbox_advisor/__init__.py
!/src/erp_sandbox_advisor/__main__.py
!/src/erp_sandbox_advisor/core.py
/tests/*
!/tests/test_core.py
!/tests/test_cli.py
